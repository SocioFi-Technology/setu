# Copy to .env and fill in. Never commit .env. On staging / production the values live in the host's secret store
# (ADR 0019); production refuses to start when a required one is missing (apps/api/src/config.ts).
# Generate a secret with: openssl rand -base64 48

# ── runtime ─────────────────────────────────────────────────────────────────────────────────────────────────────────
# development | test | production — production turns on every startup check below
NODE_ENV=development
API_PORT=4000

# ── database and counters ──────────────────────────────────────────────────────────────────────────────────────────
# Owner (migrations, seed only). The API never uses it: the owner bypasses row-level security.
DATABASE_URL=postgresql://setu:setu@localhost:5432/setu
# API connection: the non-superuser role RLS applies to. `pnpm db:migrate` / `pnpm db:set-app-password` set this
# password on the role (as a SCRAM verifier, gap 10). Required in production.
DATABASE_URL_APP=postgresql://setu_app:setu_app_dev@localhost:5432/setu
# login failures, account locks and signing-PIN tries (external review A3) — required in production
REDIS_URL=redis://localhost:6379

# ── secrets (each 32+ characters in production) ─────────────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-32-chars-minimum-please
# WRISTBAND_SECRET=  (defaults to SESSION_SECRET in dev; rotating it retires every printed band) — required in production
# the payment gateway's stored tokens are encrypted with this (external review B6); dev without it: a fixed dev key
GATEWAY_TOKEN_KEY=
# the device keys (sealed drafts and queued writes, gap 10); not the session secret; dev without it: SESSION_SECRET
DEVICE_KEY_SECRET=

# ── public addresses and the proxy (staging, week 2) ───────────────────────────────────────────────────────────────
# The staff app's public origin (https in production): payment links, bKash's return and the payment result page use it
PUBLIC_APP_URL=http://localhost:3000
# what a receipt's QR opens (https in production)
VERIFY_BASE_URL=http://localhost:3000/verify/rc
# the root of the prescription / report / summary QR pages (default: VERIFY_BASE_URL without /rc); https in production
# VERIFY_DOC_ROOT_URL=
# how many proxies stand in front of the API: development 1 (the staff app's /api rewrite); staging behind Caddy 2.
# Required in production. Rate limits and the audit log take the client's address from it.
TRUST_PROXY=1
# cross-origin callers allowed, comma-separated origins (the staff app is same-origin and needs none); https in production
# CORS_ORIGINS=
# the staff app (Next) proxies /api/* here — baked in at `next build`
API_URL=http://localhost:4000

# ── files (staging, week 2) ────────────────────────────────────────────────────────────────────────────────────────
# local (a folder; development and tests) | s3 (any S3-compatible store; required in production)
STORAGE=local
# STORAGE_DIR=  (default <repo>/var/storage)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=setu-dev
S3_ACCESS_KEY=setu
S3_SECRET_KEY=setusecret
# 1 for MinIO (path-style URLs); unset for AWS S3 / Cloudflare R2
S3_PATH_STYLE=1
# PDFs: the Chromium to use (the container sets /usr/bin/chromium) and the embedded fonts (container: /app/fonts)
# CHROMIUM_PATH=
# FONT_DIR=

# ── payments (ADR 0011) ────────────────────────────────────────────────────────────────────────────────────────────
# fake | bkash. Production refuses fake. bkash needs the BKASH_* settings below; Nagad stays on the fake until its slice.
PAYMENTS_PROVIDER=fake
# FakeProvider signs its callbacks with this (dev and tests only)
FAKE_PAYMENTS_SECRET=dev-only-fake-payments-secret
# Dev and tests only: the fake gateway's "play the customer" buttons and route (never set in production)
FAKE_PAYMENTS_DEV_ROUTE=1
# Sandbox: BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v2/tokenized-checkout — credentials come from bKash onboarding
# and never go in the repo. Local stand-in: `pnpm --filter @setu/api bkash:standin` prints the settings to use.
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# BKASH_TIMEOUT_MS=30000  (each payment call; the token calls are cut at 10 s)
# GATEWAY_TOKEN_LOCK_MS=15000  (how long a caller waits for another process renewing the token)
# BKASH_STANDIN_HOST= / BKASH_STANDIN_PORT=  (the local stand-in, dev only)
# the gap between two payment-link SMS for one payment (tests shorten it)
# LINK_SMS_GAP_MS=60000
# minutes a gateway refund may stay "processing" before the owner may settle it by hand (decision 235)
# REFUND_RELEASE_MINUTES=30

# ── SMS (ADR 0012) ─────────────────────────────────────────────────────────────────────────────────────────────────
# fake | bulksmsbd. Production refuses fake. bulksmsbd needs the key and the sender id (a number until BTRC approves a
# masking name); the key goes only in .env, never in the repo. Local stand-in: `pnpm --filter @setu/api sms:standin`.
SMS_PROVIDER=fake
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
# BULKSMSBD_URL=https://bulksmsbd.net/api/smsapi
# BULKSMSBD_TIMEOUT_MS=15000
# SMS_STANDIN_PORT=  (the local stand-in, dev only)
# dev and tests only: the fake SMS gateway's helpers (make the next SMS fail, list what was "sent"); never in production.
# Off by default (security review A8–A11): set 1 in your local .env for dev and the e2e journeys; vitest sets it itself.
FAKE_MESSAGING_DEV_ROUTE=0

# ── AI and dev helpers ─────────────────────────────────────────────────────────────────────────────────────────────
# fake (dev and tests — deterministic sample drafts) | off (no AI panel). Production refuses fake (review A1).
AI_PROVIDER=fake
# dev and tests only: POST /v1/dev/rollup/run runs the owner dashboard's nightly rollup now (never in production)
ROLLUP_DEV_ROUTE=0
# `pnpm db:reset-e2e` refuses a database that is not on localhost unless this is 1 (a disposable test database only;
# never staging or production)
# E2E_RESET_ALLOWED=
# a second Next dev server beside another (journeys); and API tests print the cause of a 500
# NEXT_DIST_DIR=
# SETU_TEST_ERRORS=
