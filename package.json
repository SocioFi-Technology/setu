{
  "name": "setu",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "pnpm --filter @setu/e2e e2e",
    "lint": "turbo run lint",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @setu/db migrate",
    "db:set-app-password": "pnpm --filter @setu/db set-app-password",
    "db:seed": "pnpm --filter @setu/db seed",
    "db:studio": "pnpm --filter @setu/db studio",
    "contracts:gen": "pnpm --filter @setu/contracts gen",
    "db:reset-e2e": "pnpm --filter @setu/db reset-e2e"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "@playwright/test"
    ]
  }
}
