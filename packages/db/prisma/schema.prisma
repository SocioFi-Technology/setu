// Setu Health — phase 0 schema: tenancy, identity, audit, idempotency.
// Source of truth for the shape: docs/design-handoff/domain-model.md. Add models in the order
// docs/BUILD-PLAN.md gives. Every model has tenantId; RLS policies live in the migration SQL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  clinic
  lite
  pro
}

enum Role {
  receptionist
  doctor
  nurse
  labTech
  pathologist
  pharmacist
  cashier
  owner
  admin
}

/// ADR 0010
enum OrgStatus {
  setup
  live
}

enum LocationKind {
  branch
  department
  ward
  room
  bed
}

enum BedState {
  vacant
  reserved
  occupied
  discharge_pending
  cleaning
  blocked
}

enum IdentityConfidence {
  verified
  unverified
  possible_duplicate
  provisional
}

enum Sex {
  male
  female
  other
}

model Tenant {
  id              String         @id @default(cuid())
  name            String
  plan            Plan           @default(clinic)
  /// facility number prefix, e.g. "GLC" → GLC-240117 (Sequence "patient" supplies the number)
  patientNoPrefix String         @default("PT")
  createdAt       DateTime       @default(now())
  organizations   Organization[]
  users           User[]
  patients        Patient[]
  auditEvents     AuditEvent[]
}

/// A facility (hospital or clinic). A tenant may own several.
model Organization {
  id                        String             @id @default(cuid())
  tenantId                  String
  tenant                    Tenant             @relation(fields: [tenantId], references: [id])
  name                      String
  nameBn                    String?
  licenceNo                 String?
  address                   String?
  /// Seller VAT registration (BIN) printed on the Mushak-6.3 receipt; null = not registered in Setu, so no Mushak line
  /// (slice A6–A7 decision 5). `vatBinSample` marks the prototype's sample value in demo tenants.
  vatBin                    String?
  vatBinSample              Boolean            @default(false)
  /// Billing limits (decision 4): cashier discount limit = lower of the amount and the percent of the subtotal; an
  /// approver (owner/admin) approves at most approverLimitPaisa per request. Paisa / basis points.
  cashierDiscountLimitPaisa Int                @default(50000)
  cashierDiscountLimitBp    Int                @default(500)
  approverLimitPaisa        Int                @default(1000000)
  /// decision 180 (external review A6): a supplier bill's line may differ from the order by min(bp, paisa) and still be
  /// posted by the pharmacist; beyond it the owner / admin posts it
  grnToleranceBp            Int                @default(200)
  grnTolerancePaisa         Int                @default(5000)
  /// dose label page (ADR 0009): printed through the browser on this page size, so any thermal printer with a driver works
  labelWidthMm              Int                @default(50)
  labelHeightMm             Int                @default(30)
  /// Lab (ADR 0006): may one person both technically verify and clinically validate a result? null = by plan
  /// (Clinic: yes; Hospital Lite / Pro: no) — @setu/domain lab.ts samePersonAllowed; the database checks it too.
  labSamePersonAllowed      Boolean?
  /// ADR 0010: setup until the go-live checklist is complete; facilities that existed before are live
  status                    OrgStatus          @default(live)
  liveAt                    DateTime?
  /// receipt (a5 | thermal) and prescription (a5 | a4) formats chosen at onboarding
  receiptFormat             String?
  rxFormat                  String?
  /// payment methods this facility takes (cash | card | bank | bkash | nagad)
  paymentMethods            String[]           @default([])
  smsTestedAt               DateTime?
  /// ADR 0012: a test SMS the gateway accepted (no delivery reports) — done only when the admin confirms it arrived
  smsTestSentAt             DateTime?
  /// the last test SMS failed (why); a failure clears sent / tested — go-live needs a test that works now
  smsTestError              String?
  smsTestPhone              String?
  locations                 Location[]
  practitionerRoles         PractitionerRole[]
  escalationAckMinutes      Int                @default(15)
  escalationDutyDoctorIds   String[]           @default([])
  /// ADR 0016 samples: shift start hours (Dhaka) and the I/O day start
  shiftStartHours           Int[]              @default([8, 14, 20])
  ioDayStartHour            Int                @default(8)

  @@index([tenantId])
}

/// Branch → department → ward → room → bed.
model Location {
  id             String          @id @default(cuid())
  tenantId       String
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  parentId       String?
  parent         Location?       @relation("tree", fields: [parentId], references: [id])
  children       Location[]      @relation("tree")
  kind           LocationKind
  name           String
  nameBn         String?
  /// bed class (General/Cabin/HDU/ICU) and state apply when kind = bed
  bedClass       String?
  bedState       BedState?
  /// why a bed is blocked / what cleaning is under way (ADR 0014); cleared when it is vacant again
  bedNote        String?
  bedAssignments BedAssignment[]

  @@index([tenantId, organizationId])
  @@index([parentId])
}

/// Login identity. A receptionist is a User with a role but no Practitioner record.
model User {
  id                    String             @id @default(cuid())
  tenantId              String
  tenant                Tenant             @relation(fields: [tenantId], references: [id])
  phone                 String?
  email                 String?
  nameBn                String
  nameEn                String
  passwordHash          String
  pinHash               String?
  active                Boolean            @default(true)
  /// ADR 0010: signed in with a one-time password — sets their own password and PIN before anything else
  mustChangePassword    Boolean            @default(false)
  tempPasswordExpiresAt DateTime?
  /// a one-time password works for one sign-in (ADR 0010 review)
  tempPasswordUsedAt    DateTime?
  /// every session carries it; deactivation, a role change and a password reset bump it (signed out everywhere)
  sessionGeneration     Int                @default(0)
  lastLoginAt           DateTime?
  deactivatedAt         DateTime?
  deactivatedReason     String?
  /// decision 317: the tenant's system actor (id sys_<tenant>, no password, no role, inactive) — "done by" for what an
  /// event finished
  system                Boolean            @default(false)
  roles                 PractitionerRole[]
  sessions              Session[]
  practitioner          Practitioner?
  createdAt             DateTime           @default(now())

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
}

/// Which role a user holds at which facility.
model PractitionerRole {
  id             String       @id @default(cuid())
  tenantId       String
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role

  @@unique([userId, organizationId, role])
  @@index([tenantId])
}

/// Clinical identity for doctors, nurses, pathologists.
model Practitioner {
  id          String  @id @default(cuid())
  tenantId    String
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id])
  regBody     String? // BMDC / BNMC
  regNo       String?
  regVerified Boolean @default(false)
  degrees     String?
  speciality  String?

  @@index([tenantId])
}

model Session {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  deviceId       String?
  device         Device?  @relation(fields: [deviceId], references: [id])
  organizationId String
  role           Role
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([tenantId, userId])
}

model Device {
  id         String    @id @default(cuid())
  tenantId   String
  label      String?
  pushToken  String?
  lastSyncAt DateTime?
  sessions   Session[]

  @@index([tenantId])
}

model Patient {
  id                 String               @id @default(cuid())
  tenantId           String
  tenant             Tenant               @relation(fields: [tenantId], references: [id])
  /// display number, e.g. GLC-240117 — from a per-tenant sequence, Latin digits
  facilityNo         String
  setuId             String?              @unique
  nid                String?
  birthRegNo         String?
  nameBn             String
  nameEn             String?
  sex                Sex
  birthDate          DateTime?
  approxAgeYears     Int?
  approxAgeMonths    Int?
  /// when the approximate age was recorded, so it can be aged forward
  approxAgeAt        DateTime?
  phone              String?
  phoneOwner         String? // self | guardian | shared
  division           String?
  district           String?
  upazila            String?
  addressLine        String?
  photoKey           String?
  identityConfidence IdentityConfidence   @default(unverified)
  identityMethod     String?
  linkedToId         String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  relatedPersons     RelatedPerson[]
  encounters         Encounter[]
  observations       Observation[]
  allergies          AllergyIntolerance[]
  compositions       Composition[]

  @@unique([tenantId, facilityNo])
  /// gap 10: the target of composite (tenantId, id) foreign keys (Encounter.patientId, Patient.linkedToId — raw SQL)
  @@unique([tenantId, id])
  @@index([tenantId, phone])
  @@index([tenantId, nameBn])
  @@index([tenantId, nameEn])
}

model RelatedPerson {
  id            String  @id @default(cuid())
  tenantId      String
  patientId     String
  patient       Patient @relation(fields: [patientId], references: [id])
  relationship  String
  nameBn        String
  phone         String?
  guardianProof String?
  verified      Boolean @default(false)

  @@index([tenantId, patientId])
}

/// Rule 5: every PHI-revealing action. Append-only; no updates or deletes (enforced in migration SQL).
model AuditEvent {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  at             DateTime @default(now())
  userId         String?
  role           Role?
  action         String // view | create | update | sign | print | reprint | break-glass | login
  entity         String // model name
  entityId       String?
  patientId      String?
  deviceId       String?
  ip             String?
  basis          String? // patient | referral | policy | emergency
  /// ADR 0010 review: the facility the event happened at (the admin's audit log is per facility); null = tenant-level
  organizationId String?
  detail         Json?

  @@index([tenantId, patientId, at])
  @@index([tenantId, at])
  @@index([tenantId, organizationId, at])
}

/// Stored response for a replayed mutation (offline retries never double-post).
model IdempotencyKey {
  id         String   @id @default(cuid())
  tenantId   String
  key        String
  route      String
  statusCode Int
  response   Json
  createdAt  DateTime @default(now())

  @@unique([tenantId, key, route])
  @@index([createdAt])
}

/// Per-tenant counters for display numbers (facility no, invoice no, daily tokens).
model Sequence {
  tenantId String
  name     String
  value    Int    @default(0)

  @@id([tenantId, name])
}

/// ENCOUNTER machine states (@setu/domain machines.ts). Changed only through transition().
enum EncounterStatus {
  planned
  arrived
  triaged
  in_progress      @map("in-progress")
  finished
  cancelled
  entered_in_error @map("entered-in-error")
}

enum EncounterClass {
  opd
  ipd
  er
  home
}

/// A visit. The queue token is an attribute of the Encounter: A-017 = tokenNo 17 at tokenBranchId on tokenDay
/// (Asia/Dhaka calendar date), numbered from the Sequence "token:<branchId>:<day>".
model Encounter {
  id             String          @id @default(cuid())
  tenantId       String
  organizationId String
  branchId       String
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id])
  class          EncounterClass  @default(opd)
  status         EncounterStatus
  /// new | follow-up | report
  visitType      String          @default("new")
  practitionerId String?
  token          String
  tokenNo        Int
  tokenDay       String
  arrivedAt      DateTime?
  calledAt       DateTime?
  statusAt       DateTime        @default(now())
  cancelReason   String?
  createdById    String
  createdAt      DateTime        @default(now())
  observations   Observation[]
  compositions   Composition[]
  erVisit        ErVisit?
  admission      Admission?
  bedAssignments BedAssignment[]
  /// ADR 0018: the inpatient visit's outcome when not a normal discharge — lama | deceased
  outcome        String?

  /// ADR 0014: tokens are numbered per class (OPD A-nnn, ER E-nnn) per branch per day
  @@unique([tenantId, branchId, tokenDay, class, tokenNo])
  @@index([tenantId, branchId, tokenDay])
  @@index([tenantId, patientId])
}

/// ADR 0014: the ER visit's own facts, one to one with an Encounter of class er. The triage level is on the sample
/// scale in @setu/domain er.ts (pending clinician sign-off); the disposition is signed on the ER note (Composition
/// kind er-note) and copied here.
model ErVisit {
  id                    String    @id @default(cuid())
  tenantId              String
  organizationId        String
  branchId              String
  encounterId           String    @unique
  encounter             Encounter @relation(fields: [encounterId], references: [id])
  patientId             String
  /// walk-in | ambulance | police | public | referral
  arrivalMode           String
  broughtBy             String?
  /// decision 248 / 253: the family's phone, patient-reported, normalised
  broughtByPhone        String?
  complaint             String
  /// identifying features of an unknown patient (quick provisional registration)
  features              String?
  triageLevel           Int?
  triageTargetMinutes   Int?
  triagedAt             DateTime?
  triagedById           String?
  /// admit | discharge | refer | death — set when the disposition is signed
  dispositionKind       String?
  dispositionDetail     Json?
  dispositionSignedAt   DateTime?
  dispositionSignedById String?
  /// the ER note
  compositionId         String?
  createdById           String
  createdAt             DateTime  @default(now())

  @@index([tenantId, organizationId, branchId])
  @@index([tenantId, patientId])
}

enum BedAssignmentStatus {
  reserved
  occupied
  ended
}

/// ADR 0014: a patient's hold on a bed — the Encounter's location history. A bed move is two rows (legs) with one
/// transferId, like a stock transfer: the destination is reserved, then occupied while the source is ended (vacated
/// into cleaning, or released). The database allows one live row per bed, one occupied and one reserved per patient,
/// and keeps Location.bedState in step with the live row.
model BedAssignment {
  id             String              @id @default(cuid())
  tenantId       String
  organizationId String
  encounterId    String
  encounter      Encounter           @relation(fields: [encounterId], references: [id])
  patientId      String
  bedId          String
  bed            Location            @relation(fields: [bedId], references: [id])
  status         BedAssignmentStatus
  transferId     String
  reservedAt     DateTime?
  reservedById   String?
  occupiedAt     DateTime?
  occupiedById   String?
  endedAt        DateTime?
  endedById      String?
  /// vacated | released | discharged | cancelled | reset
  endReason      String?
  createdAt      DateTime            @default(now())

  @@index([tenantId, bedId])
  @@index([tenantId, patientId])
  @@index([tenantId, encounterId])
}

/// ADR 0014: an admission — requested by the ER's admit disposition (bed reserved), completed by the desk's Admit,
/// which creates the IPD encounter, occupies the bed, draws ADM/yy/nnnn and opens the IPD bill draft.
model Admission {
  id                   String     @id @default(cuid())
  tenantId             String
  organizationId       String
  branchId             String
  patientId            String
  /// the IPD encounter, once admitted
  encounterId          String?    @unique
  encounter            Encounter? @relation(fields: [encounterId], references: [id])
  /// the ER (or OPD) visit this admission came from
  sourceEncounterId    String?
  /// opd | er | direct
  source               String
  /// requested | admitted | cancelled | discharged (ADMISSION machine)
  status               String
  number               String?
  admittingDoctorId    String
  department           String
  diagnosis            String
  bedClass             String
  /// the bed reserved (requested) / occupied (admitted)
  bedId                String
  guardianName         String?
  guardianRelationship String?
  guardianPhone        String?
  consents             String[]   @default([])
  /// the IPD bill draft (Invoice kind ipd)
  invoiceId            String?
  /// ADR 0017: the package as applied (prices per class, days, items) — set once, never re-priced by a catalogue change
  packageId            String?
  packageSnapshot      Json?
  packageAppliedById   String?
  packageAppliedAt     DateTime?
  /// ADR 0017: discharged when the ward released the bed (the checklist's last step)
  dischargedById       String?
  dischargedAt         DateTime?
  requestedById        String
  requestedAt          DateTime   @default(now())
  admittedById         String?
  admittedAt           DateTime?
  cancelledById        String?
  cancelledAt          DateTime?
  cancelReason         String?

  @@unique([tenantId, organizationId, number])
  @@index([tenantId, patientId])
  @@index([tenantId, organizationId, status])
}

/// APPROVAL machine states (@setu/domain machines.ts).
enum ApprovalStatus {
  requested
  approved
  rejected
  /// external review A6: the request no longer applies (its purchase order was cancelled) — nobody decided it
  withdrawn
}

/// Work items: approvals, reviews, checklist phases. kind "patient-link-review" = duplicate review from the front desk:
/// "Send for review" creates it requested; "Link anyway" creates it and approves it in the same transaction.
model Task {
  id            String         @id @default(cuid())
  tenantId      String
  kind          String
  status        ApprovalStatus
  /// the record under review (the possible duplicate) and the record it may be the same person as
  focusId       String?
  candidateId   String?
  reason        String?
  /// e.g. the conflicting fields at the time of the decision
  detail        Json?
  requestedById String
  requestedAt   DateTime       @default(now())
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?

  @@index([tenantId, kind, status])
  @@index([tenantId, focusId])
}

enum ProvenanceSource {
  provider_verified @map("provider-verified")
  patient_uploaded  @map("patient-uploaded")
  patient_reported  @map("patient-reported")
  ai_draft          @map("ai-draft")
  /// ADR 0002: front desk / admin identity decisions (link, link-anyway, review-requested, checked-different, undo, unlink, link-reviewed)
  desk_decision     @map("desk-decision")
}

/// Rule 2: who did what to which record, on behalf of which organisation, and from what source.
model Provenance {
  id         String           @id @default(cuid())
  tenantId   String
  targetType String
  targetId   String
  /// register | link | unlink | review-requested | checked-different | ...
  activity   String
  agentId    String
  onBehalfOf String
  recorded   DateTime         @default(now())
  source     ProvenanceSource
  reason     String?
  detail     Json?

  @@index([tenantId, targetType, targetId])
}

/// Observation.status. Vitals are stored `final` when the server accepts the batch; "preliminary" exists only as the
/// device's pending outbox write (open question 36). Lab results (ADR 0006, RESULT machine): preliminary → verified →
/// final; a correction marks the old row entered-in-error and adds a new row. Never an edit of a value.
enum ObservationStatus {
  preliminary
  verified
  final
  amended
  entered_in_error @map("entered-in-error")
}

/// Observation.interpretation (@setu/domain vitals.ts): normal, high, low, critical high, critical low.
enum ObservationInterpretation {
  N
  H
  L
  HH
  LL
}

/// One measured value (slice A4: vital signs). A save is a batch (`batchId`) written in one transaction with one
/// Provenance row and one AuditEvent. Append-only for the API (migration): a wrong value is corrected by a new row.
/// `code` is a Setu key (bp-systolic, pulse, …), not a LOINC code — terminology mapping comes with the FHIR export.
model Observation {
  id               String                     @id @default(cuid())
  tenantId         String
  organizationId   String
  branchId         String
  patientId        String
  patient          Patient                    @relation(fields: [patientId], references: [id])
  encounterId      String
  encounter        Encounter                  @relation(fields: [encounterId], references: [id])
  batchId          String
  category         String                     @default("vital-signs")
  code             String
  value            Float
  unit             String
  /// e.g. glucose: random | fasting; BMI: calculated
  method           String?
  interpretation   ObservationInterpretation?
  status           ObservationStatus          @default(final)
  recordedById     String
  /// when it was measured (as entered on the device) and when the server stored it
  effectiveAt      DateTime
  recordedAt       DateTime                   @default(now())
  deviceLabel      String?
  /**
   * ── lab results (category "laboratory", slice A8–A11, ADR 0006); null for vital signs ──
   */
  /// the test (order) and the tube it was measured in; null only for seeded history (Rahima's 12/08 results)
  serviceRequestId String?
  specimenId       String?
  /// the range and thresholds used when the value was entered (a snapshot: a later change to the sample list never
  /// re-flags a stored result); refLabel adult | adult-female | adult-male; no range = none in the sample list
  refLow           Float?
  refHigh          Float?
  refLabel         String?
  critLow          Float?
  critHigh         Float?
  /// delta check at entry: the previous validated result it was compared with and the change in percent
  deltaPrevId      String?
  deltaPct         Int?
  /// a correction: the row this one replaces (which is entered-in-error)
  replacesId       String?                    @unique
  verifiedById     String?
  verifiedAt       DateTime?
  validatedById    String?
  validatedAt      DateTime?
  errorReason      String?
  errorById        String?
  errorAt          DateTime?
  /// send-back (decision 119): the pathologist returned the verified test to the technologist (verify again)
  returnedById     String?
  returnedAt       DateTime?
  returnReason     String?
  statusAt         DateTime?

  @@index([tenantId, patientId, code, effectiveAt])
  @@index([tenantId, serviceRequestId])
  @@index([tenantId, encounterId])
  @@index([tenantId, batchId])
}

/**
 * ───────────── Slice A5: consultation ─────────────
 */

/// Sample catalogues per tenant, seeded from @setu/domain catalog.ts (NOT a drug database or a terminology server:
/// pre-pilot, HANDOVER known gap 12). The API searches these; the prescription rules read `ingredients`/`classes`.
model Icd11Code {
  id           String @id @default(cuid())
  tenantId     String
  code         String
  bn           String
  en           String
  aliases      String @default("")
  /// unverified-prototype until a clinician checks it against the WHO ICD-11 browser (decision D2)
  verification String @default("unverified-prototype")

  @@unique([tenantId, code])
}

enum MealTiming {
  before
  after
  with
  any
}

model Medicine {
  id            String     @id @default(cuid())
  tenantId      String
  /// Setu key from the sample list (e.g. "seclo"); never a DGDA number
  key           String
  brand         String
  brandBn       String     @default("")
  generic       String
  strength      String
  form          String
  manufacturer  String
  ingredients   String[]
  classes       String[]
  defaultDose   String
  defaultMeal   MealTiming
  defaultDays   Int
  /// true for every row until a licensed database replaces the sample list (decision D3)
  sample        Boolean    @default(true)
  active        Boolean    @default(true)
  /// ADR 0015 (sample, pending clinician sign-off): ward use — hidden from OPD search, high-alert (witness), controlled
  /// (register), multi-dose vial (consumed when opened), the unit the pharmacy issues, the routes it may be given by
  inpatientOnly Boolean    @default(false)
  highAlert     Boolean    @default(false)
  controlled    Boolean    @default(false)
  multiDose     Boolean    @default(false)
  issueUnit     String     @default("tablet")
  routes        String[]   @default(["oral"])

  @@unique([tenantId, key])
}

model OrderableTest {
  id       String  @id @default(cuid())
  tenantId String
  /// Setu key (cbc, rbs, elec, ...), not LOINC
  code     String
  nameEn   String
  nameBn   String
  /// lab | imaging | other
  group    String
  active   Boolean @default(true)

  @@unique([tenantId, code])
}

/// ALLERGY machine states (@setu/domain machines.ts, ADR 0004).
enum AllergyStatus {
  active
  entered_in_error @map("entered-in-error")
}

/// class = a drug class key (penicillin, sulfonamide); substance = an ingredient key; other = free text (not matchable)
enum AllergyKind {
  class
  substance
  other
}

enum AllergySeverity {
  mild
  moderate
  severe
  unknown
}

/// ADR 0004: never deleted, never edited; a wrong entry is marked entered-in-error with a reason (enforced by trigger).
model AllergyIntolerance {
  id             String          @id @default(cuid())
  tenantId       String
  organizationId String
  patientId      String
  patient        Patient         @relation(fields: [patientId], references: [id])
  /// the visit during which it was recorded
  encounterId    String?
  kind           AllergyKind
  /// class or ingredient key; null for free text
  key            String?
  labelBn        String
  labelEn        String
  reaction       String?
  severity       AllergySeverity @default(unknown)
  status         AllergyStatus   @default(active)
  recordedById   String
  recordedAt     DateTime        @default(now())
  errorReason    String?
  errorById      String?
  errorAt        DateTime?

  @@index([tenantId, patientId, status])
}

/// DOCUMENT machine states (@setu/domain machines.ts, ADR 0003).
enum DocumentStatus {
  draft
  queued
  final
  amended
  superseded
  entered_in_error @map("entered-in-error")
}

/// A clinical note, one row per version (ADR 0003). v1 starts as a draft; signing (PIN + server) makes it final. An
/// amendment is a new row (version + 1, `amendsId` = the version it amends, reason required) that signs to `amended`
/// while the old row is superseded in the same transaction. Signed rows are never edited (trigger): only their status
/// moves on to superseded / entered-in-error. Sections are JSON (@setu/domain NoteSections) with a source per section.
model Composition {
  id                      String              @id @default(cuid())
  tenantId                String
  organizationId          String
  branchId                String
  patientId               String
  patient                 Patient             @relation(fields: [patientId], references: [id])
  encounterId             String
  encounter               Encounter           @relation(fields: [encounterId], references: [id])
  /// consultation-note (others later: progress note, discharge summary, ...)
  kind                    String              @default("consultation-note")
  version                 Int
  status                  DocumentStatus      @default(draft)
  amendsId                String?             @unique
  supersededById          String?
  amendReason             String?
  sections                Json
  sectionSources          Json
  /// check-and-set counter for draft saves (409 when another save came first)
  rev                     Int                 @default(1)
  authorId                String
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  signedAt                DateTime?
  signedById              String?
  aiReviewed              Boolean             @default(false)
  uncodedAllergiesChecked Boolean             @default(false)
  /// ADR 0010 review: the signer's registration as it was at signing (filled by the database; never changes after)
  signerRegBody           String?
  signerRegNo             String?
  signerRegVerified       Boolean?
  conditions              Condition[]
  medications             MedicationRequest[]
  orders                  ServiceRequest[]
  /// ADR 0015: a ward round note (kind progress-note) is one thread of versions: the id of its v1. Version uniqueness
  /// and the one-current rule are per thread for progress notes, per (encounter, kind) for the others (partial unique
  /// indexes in the migration).
  threadId                String?

  @@index([tenantId, patientId, status])
  @@index([tenantId, encounterId, kind])
}

enum ConditionVerification {
  provisional
  confirmed
}

/// A diagnosis on one version of a note. Labels are copied from the tenant's Icd11Code row by the server.
model Condition {
  id                 String                @id @default(cuid())
  tenantId           String
  patientId          String
  encounterId        String
  compositionId      String
  composition        Composition           @relation(fields: [compositionId], references: [id])
  position           Int
  code               String
  codeSystem         String                @default("icd11")
  /// copied from Icd11Code.verification (unverified-prototype) so prints and exports can say so
  codeVerification   String
  labelBn            String
  labelEn            String
  verificationStatus ConditionVerification @default(provisional)
  createdAt          DateTime              @default(now())

  @@index([tenantId, compositionId])
  @@index([tenantId, patientId])
}

/// A prescription line on one version of a note. Medicine data is copied from the tenant's Medicine row by the server
/// (the screen sends only the medicine key), so the sign check uses the server's ingredients and classes.
model MedicationRequest {
  id            String                @id @default(cuid())
  tenantId      String
  patientId     String
  encounterId   String
  compositionId String
  composition   Composition           @relation(fields: [compositionId], references: [id])
  position      Int
  medicineKey   String
  brand         String
  generic       String
  strength      String
  form          String
  ingredients   String[]
  classes       String[]
  sample        Boolean               @default(true)
  /// dose pattern m+n+e[+bed], e.g. 1+0+1
  dose          String
  meal          MealTiming
  days          Int
  quantity      Int
  note          String?
  keepBoth      Boolean               @default(false)
  /// interaction rule ids the doctor acknowledged on this line
  acks          String[]
  createdAt     DateTime              @default(now())
  /// ── ADR 0015: an inpatient order on a ward round note (kind inpatient); opd lines leave these at their defaults ──
  kind          String                @default("opd")
  route         String?
  doseText      String?
  /// issue units one dose takes from ward stock; null for a multi-dose vial
  doseQty       Int?
  /// Dhaka times of day (HH:MM); empty for PRN
  times         String[]              @default([])
  prn           Boolean               @default(false)
  prnMaxPer24h  Int?
  /// set at signing: when the order started, and its regimen (the first line of a chain of unchanged continuations)
  startAt       DateTime?
  regimenId     String?
  continuesId   String?
  orderStatus   MedicationOrderStatus @default(active)
  stoppedAt     DateTime?
  stoppedById   String?
  stopReason    String?

  @@index([tenantId, compositionId])
  @@index([tenantId, patientId])
  @@index([tenantId, encounterId, kind])
}

enum MedicationOrderStatus {
  active
  stopped
  superseded
  completed
}

/// ORDER machine states (@setu/domain machines.ts).
enum OrderStatus {
  draft
  active
  centre_chosen      @map("centre-chosen")
  accepted
  partially_accepted @map("partially-accepted")
  declined
  in_progress        @map("in-progress")
  partially_complete @map("partially-complete")
  complete
  revoked
}

enum OrderPriority {
  routine
  urgent
  stat
}

/// A test ordered in a consultation. Belongs to the visit (the A6 bill and the A8 lab read it from there) and to the
/// note version that placed it; draft until that version is signed (ORDER `order` -> active). An amendment can add
/// orders but never removes one already placed (cancelling is ORDER `revoke`, in the lab slice). In-house only;
/// network labs come with Journey E. No price until price lists exist (decision 29).
model ServiceRequest {
  id                String        @id @default(cuid())
  tenantId          String
  organizationId    String
  branchId          String
  patientId         String
  encounterId       String
  compositionId     String
  composition       Composition   @relation(fields: [compositionId], references: [id])
  testCode          String
  nameEn            String
  nameBn            String
  group             String
  priority          OrderPriority @default(routine)
  status            OrderStatus   @default(draft)
  note              String?
  orderedById       String
  createdAt         DateTime      @default(now())
  orderedAt         DateTime?
  statusAt          DateTime      @default(now())
  /// ADR 0014 addendum (decision 243): a nurse's protocol order in the ER, countersigned by the doctor's disposition sign
  protocol          Boolean       @default(false)
  countersignedById String?
  countersignedAt   DateTime?
  /// ORDER revoke (cancel before collection, decision D5): who, when, why (at least 10 characters)
  revokedById       String?
  revokedAt         DateTime?
  revokeReason      String?

  @@index([tenantId, encounterId])
  /// the lab worklist: a branch's lab orders, newest first (review: it fetched every order of 30 days)
  @@index([tenantId, branchId, group, orderedAt])
  @@index([tenantId, compositionId])
}

/**
 * ── Billing (slice A6–A7). Every amount is integer paisa; VAT rates are basis points (1500 = 15%). Line maths and
 * totals come from @setu/domain billing.ts; the database re-checks the arithmetic and the state rules. ──
 */

enum ChargeKind {
  consultation
  test
  service
  /// ADR 0009: a medicine from a pharmacy batch
  medicine
}

/// The facility's price list. Seeded from the prototype's sample prices (`sample` = not a real tariff); read-only for
/// the API until the masters screens exist. code: consult:<doctor user id> | test:<OrderableTest code> | desk:<key>.
model ChargeItemDefinition {
  id             String     @id @default(cuid())
  tenantId       String
  organizationId String
  code           String
  kind           ChargeKind
  /// test → OrderableTest.code; consultation → the doctor's User id; service → null
  refCode        String?
  nameEn         String
  nameBn         String
  unitPaisa      Int
  vatRateBp      Int        @default(0)
  sample         Boolean    @default(true)
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())

  @@unique([tenantId, organizationId, code])
}

/// ADR 0010: every change to a price-list item (append-only): the old and new price and VAT, why, who, when.
model ChargePriceChange {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  definitionId   String
  code           String
  oldUnitPaisa   Int?
  newUnitPaisa   Int
  oldVatRateBp   Int?
  newVatRateBp   Int
  reason         String?
  byId           String
  at             DateTime @default(now())

  @@index([tenantId, organizationId, at])
  @@index([definitionId])
}

/// INVOICE machine states (@setu/domain machines.ts).
enum InvoiceStatus {
  draft
  issued
  partially_paid   @map("partially-paid")
  balanced
  cancelled
  /// ADR 0005: void (owner/admin, reason; never with confirmed money)
  entered_in_error @map("entered-in-error")
}

/// An OPD bill for one visit. Lines change only while it is a draft; issuing assigns INV/yy/nnnn (per facility per
/// year) and freezes lines and totals. A discount above the cashier's limit is a Task (kind "discount-approval",
/// focusId = this invoice) — never a flag here — and the bill cannot be issued while that Task is requested.
model Invoice {
  id                  String        @id @default(cuid())
  tenantId            String
  organizationId      String
  branchId            String
  patientId           String?
  encounterId         String?
  status              InvoiceStatus @default(draft)
  kind                InvoiceKind   @default(opd)
  /// otc: a walk-in buyer (optional)
  buyerName           String?
  buyerPhone          String?
  /// otc: the prescription photo for an Rx-only item (Storage key)
  rxPhotoKey          String?
  number              String?
  subtotalPaisa       Int           @default(0)
  discountPaisa       Int           @default(0)
  netPaisa            Int           @default(0)
  vatPaisa            Int           @default(0)
  totalPaisa          Int           @default(0)
  /// sum of confirmed payments
  paidPaisa           Int           @default(0)
  /// ADR 0018: the IPD final bill — deposits held beyond the total at issue (a deposit-excess refund); set once at issue.
  /// The bill counts net paid = paid − excess.
  excessPaisa         Int           @default(0)
  discountCategory    String?
  discountReason      String?
  discountAppliedById String?
  discountAppliedAt   DateTime?
  /// the approval Task that allowed the discount (null when it was within the cashier's limit)
  discountTaskId      String?
  /// check-and-set for edits from two counters
  rev                 Int           @default(1)
  createdById         String
  createdAt           DateTime      @default(now())
  issuedById          String?
  issuedAt            DateTime?
  /// ADR 0005: void (entered-in-error) — who, when, why
  voidReason          String?
  voidedById          String?
  voidedAt            DateTime?
  /// the voided bill this one replaces (same visit); on the voided bill, the replacement once it is issued
  replacesId          String?
  replacedById        String?
  /// ADR 0013: money of this bill paid back (refunds of source "bill", allocations paid out); the database keeps it
  /// equal to their sum. Confirmed payments stay confirmed: paid − refunded is what the facility keeps.
  refundedPaisa       Int           @default(0)
  /// Kamrul, decision 221: medicine returned on an unpaid bill (returns without refund) — the due goes down by it
  creditedPaisa       Int           @default(0)
  statusAt            DateTime      @default(now())
  lines               ChargeItem[]
  payments            Payment[]
  refunds             Refund[]

  @@unique([tenantId, organizationId, number])
  @@index([tenantId, encounterId])
  @@index([tenantId, status])
}

enum ChargeSource {
  consultation
  order
  desk
  /// ADR 0009: a dispense of a prescription line (sourceId = MedicationDispense) / an over-the-counter sale line
  dispense
  sale
  /// ADR 0017, IPD bills only: the package, a bed day (midnight census), ward stock drawn for the patient
  package
  bed_day      @map("bed-day")
  stock
}

/// ADR 0009: opd = the visit's consultation and tests bill; pharmacy = the visit's dispensed medicines; otc = an
/// over-the-counter sale (no visit; the patient is optional — a walk-in buyer)
enum InvoiceKind {
  opd
  pharmacy
  otc
  /// ADR 0014: the inpatient running bill, opened by the admission and nowhere else
  ipd
}

/// A bill line (FHIR ChargeItem). Name, price and VAT rate are copied from the price list when the line is added, so a
/// later price change never alters a bill. unitPaisa null = no price set: the line is shown and blocks issuing.
model ChargeItem {
  id               String       @id @default(cuid())
  tenantId         String
  invoiceId        String
  invoice          Invoice      @relation(fields: [invoiceId], references: [id])
  position         Int
  source           ChargeSource
  /// consultation → the Encounter id; order → the ServiceRequest id; desk → null
  sourceId         String?
  /// ADR 0009: medicine lines — the batch the units came from and the medicine
  batchId          String?
  medicineKey      String?
  definitionId     String?
  code             String
  nameEn           String
  nameBn           String
  unitPaisa        Int?
  qty              Int          @default(1)
  vatRateBp        Int          @default(0)
  grossPaisa       Int          @default(0)
  discountPaisa    Int          @default(0)
  netPaisa         Int          @default(0)
  vatPaisa         Int          @default(0)
  totalPaisa       Int          @default(0)
  /// decision 98: "Not billed here" — an unpriced order line excluded by an approved bill-elsewhere Task
  notBilledReason  String?
  notBilledTaskId  String?
  notBilledAt      DateTime?
  /// ADR 0017 (IPD bills): the source key (pkg, bed:<n>, order:<id>, stock:<ref>:<id>:<batch>, manual:<id>, credit:<key>),
  /// the tag (package | included | excluded), the bed day and its class; posted by the census or a sync = auto
  key              String?
  tag              String?
  serviceDay       String?
  dayNo            Int?
  bedClass         String?
  auto             Boolean      @default(false)
  /// a re-priced line: the line that replaced it (set once; the old line keeps every value)
  supersededById   String?
  supersededAt     DateTime?
  supersededReason String?
  /// a credit line: the line it reverses (qty negative); on the reversed line, the credit line
  creditOfId       String?
  creditedById     String?
  addedById        String?
  createdAt        DateTime     @default(now())

  @@unique([invoiceId, position])
  @@index([tenantId, invoiceId])
}

/// PAYMENT machine states (@setu/domain machines.ts). No way out of confirmed.
enum PaymentStatus {
  initiated
  link_sent        @map("link-sent")
  waiting_customer @map("waiting-customer")
  confirmed
  failed
}

enum PaymentMethod {
  cash
  card
  bank
  bkash
  nagad
}

/// Money against an invoice (FHIR PaymentNotice). Cash/card/bank confirm when the cashier records them; a wallet
/// payment confirms only from the provider (callback or TrxID check). A confirmed payment is never edited or deleted.
model Payment {
  id                  String        @id @default(cuid())
  tenantId            String
  organizationId      String
  invoiceId           String
  invoice             Invoice       @relation(fields: [invoiceId], references: [id])
  patientId           String?
  method              PaymentMethod
  status              PaymentStatus
  amountPaisa         Int
  tenderedPaisa       Int?
  changePaisa         Int?
  /// card approval code or bank reference
  reference           String?
  /// fake | bkash | nagad (wallets only)
  provider            String?
  /// the provider's id for the current attempt; earlier attempts' ids move to supersededRefs on retry
  providerRef         String?
  supersededRefs      String[]      @default([])
  linkUrl             String?
  linkExpiresAt       DateTime?
  /// our short link (/v1/pay/<code>) to the current link; a new one on each attempt (ADR 0011)
  linkCode            String?       @unique
  /// earlier attempts' short links: they lead to "this link has ended", never to "not found"
  supersededLinkCodes String[]      @default([])
  /// what the gateway returned at create; the patient's return must carry the same (bKash, ADR 0011)
  providerSignature   String?
  /// the one execute for the current attempt was claimed (bKash: money moves at execute, once)
  executeClaimedAt    DateTime?
  /// the number the payment link went to
  phone               String?
  trxId               String?
  attempt             Int           @default(1)
  failReason          String?
  createdById         String
  createdAt           DateTime      @default(now())
  confirmedAt         DateTime?
  /// the cashier for cash/card/bank; null when the provider confirmed
  confirmedById       String?
  statusAt            DateTime      @default(now())

  @@unique([provider, providerRef])
  @@index([tenantId, invoiceId])
  /// callbacks for an earlier (superseded) link are looked up by reference
  @@index([supersededRefs], type: Gin)
}

/// Every provider callback, once (unique per provider event id): a repeat is answered from here and changes nothing.
/// Append-only.
model ProviderEvent {
  id          String   @id @default(cuid())
  tenantId    String
  provider    String
  eventId     String
  providerRef String
  /// opened | confirmed | failed
  kind        String
  paymentId   String?
  /// applied | noop | refused
  outcome     String
  reason      String?
  trxId       String?
  amountPaisa Int?
  receivedAt  DateTime @default(now())

  @@unique([provider, eventId])
  @@index([tenantId, paymentId])
}

/// A money receipt (slice A6–A7 session 2): an immutable copy of what was printed — bill lines, totals, confirmed
/// payments and pending wallet amounts at that moment — numbered RCPT/yy/nnnn per facility per year from Sequence in
/// the same transaction. `verifyCode` (≥16 random characters, never sequential) is what the QR's public verify URL
/// carries; the verify page shows only facility, receipt number, date and amount. Never updated or deleted.
model Receipt {
  id             String         @id @default(cuid())
  tenantId       String
  organizationId String
  invoiceId      String
  patientId      String?
  number         String
  verifyCode     String         @unique
  /// paid to date (confirmed money only) and still due, in paisa, as printed
  paidPaisa      Int
  totalPaisa     Int
  duePaisa       Int
  /// ADR 0013 (decision 221): returned medicine credited off the bill — paid + due + credited = total
  creditedPaisa  Int            @default(0)
  /// ADR 0017: bill | deposit — a deposit receipt is a money receipt for one confirmed payment on the IPD bill (DR/yy/nnnn)
  kind           String         @default("bill")
  paymentId      String?        @unique
  /// everything the receipt prints (seller, patient, lines, totals, paid by, pending, cashier)
  snapshot       Json
  createdById    String
  createdAt      DateTime       @default(now())
  prints         ReceiptPrint[]

  @@unique([tenantId, organizationId, number])
  @@index([tenantId, invoiceId])
}

/// Every print of a receipt: copy 0 = the original, n ≥ 1 = "DUPLICATE #n" with a reason. Append-only; the PDF itself
/// sits in Storage under `storageKey`.
model ReceiptPrint {
  id          String   @id @default(cuid())
  tenantId    String
  receiptId   String
  receipt     Receipt  @relation(fields: [receiptId], references: [id])
  copy        Int
  reason      String?
  /// a5 | thermal
  format      String
  /// both | bn | en
  lang        String
  storageKey  String
  printedById String
  printedAt   DateTime @default(now())

  @@unique([receiptId, copy])
  @@index([tenantId, receiptId])
}

/**
 * ───────────── Slice A8–A11: lab (ADR 0006) ─────────────
 */

/// SPECIMEN machine states (@setu/domain machines.ts).
enum SpecimenStatus {
  pending
  collected
  received
  in_process @map("in-process")
  done
  rejected
}

enum TubeKind {
  edta
  fluoride
  plain
  urine
}

/// One tube. Created when its label is printed (pending); a rejected tube is never reused — its tests get a new tube.
/// `number` (S-yymm-nnnn, per facility per month) is the barcode text, never a key.
model Specimen {
  id               String          @id @default(cuid())
  tenantId         String
  organizationId   String
  branchId         String
  patientId        String
  encounterId      String
  number           String
  tube             TubeKind
  status           SpecimenStatus  @default(pending)
  labelPrintedById String
  labelPrintedAt   DateTime
  labelPrints      Int             @default(1)
  collectedById    String?
  collectedAt      DateTime?
  receivedById     String?
  receivedAt       DateTime?
  startedById      String?
  startedAt        DateTime?
  doneAt           DateTime?
  rejectedById     String?
  rejectedAt       DateTime?
  /// @setu/domain REJECT_REASONS (`other` needs rejectNote) or results-withdrawn (decision 133)
  rejectReason     String?
  rejectNote       String?
  createdAt        DateTime        @default(now())
  statusAt         DateTime        @default(now())
  orders           SpecimenOrder[]

  @@unique([tenantId, number])
  @@index([tenantId, encounterId])
  @@index([tenantId, organizationId, status])
}

/// Which tests a tube carries (tests sharing a tube kind share a tube). Written once with the label.
model SpecimenOrder {
  tenantId         String
  specimenId       String
  specimen         Specimen @relation(fields: [specimenId], references: [id])
  serviceRequestId String

  @@id([specimenId, serviceRequestId])
  @@index([tenantId, serviceRequestId])
}

/// Sample analyte list per tenant (@setu/domain lab.ts ANALYTES_SAMPLE, pending clinician sign-off); read-only for the API.
model LabAnalyte {
  id         String  @id @default(cuid())
  tenantId   String
  code       String
  testCode   String
  nameEn     String
  nameBn     String
  unit       String
  decimals   Int
  critLow    Float?
  critHigh   Float?
  deltaCheck Boolean
  position   Int
  sample     Boolean @default(true)
  active     Boolean @default(true)

  @@unique([tenantId, code])
  @@index([tenantId, testCode])
}

/// Sample reference ranges (RANGES_SAMPLE; decision D1: adult only, Hb and creatinine adult female only). Read-only.
model LabReferenceRange {
  id          String  @id
  tenantId    String
  analyteCode String
  sex         Sex?
  ageMinYears Int
  ageMaxYears Int?
  low         Float
  high        Float
  label       String
  sample      Boolean @default(true)

  @@index([tenantId, analyteCode])
}

/// LAB_REPORT machine states. A version exists only once released.
enum LabReportStatus {
  preliminary
  final
  corrected
  superseded
}

/// One report per visit, in released versions (decision D3). Immutable except `superseded` when the next version is
/// released. `number` (LR/yy/nnnn per facility per year) is shared by all versions of the visit's report.
model DiagnosticReport {
  id             String                   @id
  tenantId       String
  organizationId String
  branchId       String
  patientId      String
  encounterId    String
  number         String
  version        Int
  status         LabReportStatus
  /// "PRELIMINARY — n of m tests pending": tests not cancelled (m) and those not in this version (n)
  testCount      Int
  pendingCount   Int
  replacesId     String?                  @unique
  supersededById String?
  releasedById   String
  releasedAt     DateTime
  createdAt      DateTime                 @default(now())
  results        DiagnosticReportResult[]

  @@unique([tenantId, encounterId, version])
  @@index([tenantId, organizationId, releasedAt])
}

model DiagnosticReportResult {
  tenantId         String
  reportId         String
  report           DiagnosticReport @relation(fields: [reportId], references: [id])
  observationId    String
  serviceRequestId String

  @@id([reportId, observationId])
  @@index([tenantId, observationId])
}

enum CallbackOutcome {
  reached
  no_answer @map("no-answer")
}

/// A critical-value call-back (ADR 0006, decision D9): append-only. Only `reached` with readBack, for that exact
/// Observation, unblocks its clinical validation; attempts that reached no one stay on record.
model CriticalCallback {
  id             String          @id @default(cuid())
  tenantId       String
  organizationId String
  patientId      String
  encounterId    String
  observationId  String
  outcome        CallbackOutcome
  /// ordering-doctor | duty-doctor | patient (@setu/domain CALLBACK_RECIPIENTS)
  recipientRole  String
  recipientName  String
  /// phone | app | in-person
  via            String
  calledAt       DateTime
  readBack       Boolean
  callerId       String
  recordedAt     DateTime        @default(now())

  @@index([tenantId, observationId])
}

/// COMMUNICATION machine states.
enum CommunicationStatus {
  preparation
  in_progress @map("in-progress")
  completed
  failed
}

enum CommunicationChannel {
  sms
  patient_app  @map("patient-app")
  doctor_inbox @map("doctor-inbox")
}

/// Every message (ADR 0006). `id` is the message id a retry reuses. SMS text is a fixed template (no values, tests,
/// diagnosis or name); in-app deliveries (doctor's inbox, patient app) carry no text, only what they point at.
model Communication {
  id                String               @id
  tenantId          String
  organizationId    String
  patientId         String
  encounterId       String?
  /// recollect | report-ready | report-app | report-inbox | correction-notice | results-withdrawn | order-cancelled |
  /// report-reviewed (SMS, ADR 0007) | critical-vital (doctor-inbox, ADR 0007)
  kind              String
  channel           CommunicationChannel
  recipientUserId   String?
  toPhone           String?
  templateKey       String?
  text              String?
  reportId          String?
  specimenId        String?
  serviceRequestId  String?
  observationId     String?
  /// substitution-notice (ADR 0009): the dispense it is about
  dispenseId        String?
  /// payment-link (ADR 0012): the payment whose short link it carries
  paymentId         String?
  /// summary-app (ADR 0018): the discharge summary version made available to the patient
  compositionId     String?
  /// completed and confirmed by the gateway as delivered; false = the gateway only accepted it ("Sent", ADR 0012)
  deliveryConfirmed Boolean              @default(false)
  status            CommunicationStatus  @default(preparation)
  attempts          Int                  @default(0)
  lastError         String?
  providerRef       String?
  createdById       String
  createdAt         DateTime             @default(now())
  sentAt            DateTime?
  completedAt       DateTime?
  statusAt          DateTime             @default(now())
  ack               InboxAck?            @relation("InboxAckItem")

  @@index([tenantId, encounterId])
  @@index([tenantId, reportId])
  @@index([tenantId, recipientUserId, channel])
}

/// The doctor's acknowledgement of a doctor-inbox Communication (ADR 0007, INBOX_ITEM unread → acknowledged):
/// append-only, one per item, only by its recipient. "Seen + tell patient" stores the SMS it queued.
model InboxAck {
  id                    String        @id @default(cuid())
  tenantId              String
  communicationId       String        @unique
  communication         Communication @relation("InboxAckItem", fields: [communicationId], references: [id])
  ackedById             String
  ackedAt               DateTime      @default(now())
  notifyPatient         Boolean       @default(false)
  notifyCommunicationId String?       @unique

  @@index([tenantId, ackedById])
}

/// The verify code of a printable clinical document version (ADR 0007): rx = a signed consultation note version
/// (Composition), lr = a released lab report version (DiagnosticReport). Created at its first print; never changed.
model DocumentCode {
  id             String          @id @default(cuid())
  tenantId       String
  organizationId String
  /// rx | lr
  kind           String
  documentId     String
  verifyCode     String          @unique
  createdById    String
  createdAt      DateTime        @default(now())
  prints         DocumentPrint[]

  @@unique([tenantId, kind, documentId])
}

/// Every print of a clinical document version: copy 0 = original, n = DUPLICATE #n with a reason. Append-only.
model DocumentPrint {
  id          String       @id @default(cuid())
  tenantId    String
  codeId      String
  code        DocumentCode @relation(fields: [codeId], references: [id])
  copy        Int
  /// lost | jam | copy
  reason      String?
  /// a5 | a4
  format      String
  /// both | bn | en
  lang        String
  storageKey  String
  printedById String
  printedAt   DateTime     @default(now())

  @@unique([codeId, copy])
  @@index([tenantId, codeId])
}

/// SHIFT machine states (@setu/domain machines.ts), ADR 0008.
enum ShiftStatus {
  open
  counted
  closed
  approved
}

/// A cashier's shift at one facility (journey C4, ADR 0008): at most one not yet approved per cashier and facility.
/// Expected cash is computed from the cashier's confirmed payments when counting; every count and every decision is an
/// append-only row (ShiftCount, ShiftReview).
model Shift {
  id                String          @id @default(cuid())
  tenantId          String
  organizationId    String
  cashierId         String
  status            ShiftStatus     @default(open)
  openingFloatPaisa Int
  openedAt          DateTime        @default(now())
  latestCountId     String?
  statusAt          DateTime        @default(now())
  counts            ShiftCount[]
  reviews           ShiftReview[]
  handovers         ShiftHandover[]

  @@index([tenantId, organizationId, status])
  @@index([tenantId, cashierId])
}

/// One count of the drawer (append-only): notes by denomination, what the system expected, digital money against the
/// settlement the cashier read, the variance and the hand-over reason.
model ShiftCount {
  id                String   @id @default(cuid())
  tenantId          String
  shiftId           String
  shift             Shift    @relation(fields: [shiftId], references: [id])
  countNo           Int
  counts            Json
  countedPaisa      Int
  openingFloatPaisa Int
  cashInPaisa       Int
  cashRefundPaisa   Int      @default(0)
  expectedCashPaisa Int
  variancePaisa     Int
  /// { bkash, nagad, card, bank } paisa the system confirmed in the window
  digitalSystem     Json
  /// what the cashier read from each settlement (missing = not entered)
  digitalSettlement Json
  reason            String?
  windowFrom        DateTime
  windowTo          DateTime
  countedById       String
  countedAt         DateTime @default(now())

  handover ShiftHandover?

  @@unique([shiftId, countNo])
  @@index([tenantId, shiftId])
}

/// The owner's / admin's decision on a closed shift (append-only): approve (with a note when there is a variance) or
/// recount (the shift goes back to open).
/// External review A5 (blind count): the hand-over of a counted shift — the reason for its count's variance, given after
/// the count was stored and the variance shown (append-only).
model ShiftHandover {
  id       String     @id @default(cuid())
  tenantId String
  shiftId  String
  shift    Shift      @relation(fields: [shiftId], references: [id])
  countId  String     @unique
  count    ShiftCount @relation(fields: [countId], references: [id])
  reason   String?
  byId     String
  at       DateTime   @default(now())

  @@index([tenantId, shiftId])
}

model ShiftReview {
  id       String   @id @default(cuid())
  tenantId String
  shiftId  String
  shift    Shift    @relation(fields: [shiftId], references: [id])
  countId  String
  decision String
  note     String?
  byId     String
  at       DateTime @default(now())

  @@index([tenantId, shiftId])
}

/// The owner dashboard's store (ADR 0008): one row per facility and Dhaka day, recomputed by the nightly job; today is
/// never stored (always live).
model DailyRollup {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  day            String
  metrics        Json
  version        Int      @default(1)
  computedAt     DateTime @default(now())

  @@unique([tenantId, organizationId, day])
}

/// ADR 0009: one batch of one medicine at one place in the facility. The quantity on hand changes only through
/// StockMove rows (the database keeps it equal to their sum and never below zero). Prices per tablet / capsule.
model StockBatch {
  id             String      @id @default(cuid())
  tenantId       String
  organizationId String
  medicineKey    String
  batchNo        String
  /// the last day it may be used (yyyy-mm-dd)
  expiry         String
  /// counter | store | fridge | quarantine
  location       String      @default("counter")
  costPaisa      Int
  mrpPaisa       Int
  vatRateBp      Int         @default(0)
  qtyOnHand      Int         @default(0)
  /// external review B9: the number of moves so far (assigned under the batch lock, in commit order)
  moveSeq        Int         @default(0)
  sample         Boolean     @default(false)
  createdAt      DateTime    @default(now())
  moves          StockMove[]

  @@unique([tenantId, organizationId, medicineKey, batchNo, location])
  @@index([tenantId, organizationId, medicineKey])
}

/// ADR 0009: the stock ledger (append-only). kind receive | dispense | sale | adjust | return | transfer.
/// ADR 0013: a return comes into a quarantine batch from a paid refund line (refType "refund-line"); quarantine →
/// counter is a transfer backed by a StockResale.
model StockMove {
  id             String     @id @default(cuid())
  tenantId       String
  organizationId String
  batchId        String
  batch          StockBatch @relation(fields: [batchId], references: [id])
  kind           String
  qty            Int
  refType        String?
  refId          String?
  reason         String?
  byId           String
  at             DateTime   @default(now())
  /// external review B9: this move's number on its batch (1, 2, …), set by the database
  batchSeq       Int?

  @@unique([batchId, batchSeq])
  @@index([tenantId, batchId])
  @@index([tenantId, organizationId, at])
}

/// ADR 0009: one dispense action on one prescription line of a signed note (append-only): units given (the prescribed
/// medicine or a same-generic substitute with a reason) or a decline with a reason.
/// ADR 0013: or units returned (action "return", pointing at the dispense it reverses) — the original is never edited.
model MedicationDispense {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  encounterId    String
  patientId      String
  compositionId  String
  requestId      String
  prescribedKey  String
  medicineKey    String
  /// dispense | decline
  action         String
  qty            Int
  reason         String?
  invoiceId      String?
  chargeItemId   String?
  /// ADR 0013: action "return" — the dispense row it reverses and the refund line that paid it back
  returnOfId     String?
  refundLineId   String?
  byId           String
  at             DateTime @default(now())

  @@index([tenantId, encounterId])
  @@index([tenantId, requestId])
}

/**
 * ───── pharmacy purchasing and counts (ADR 0009, pharmacy session 2) ─────
 */

model Supplier {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  name           String
  phone          String?
  active         Boolean  @default(true)
  sample         Boolean  @default(false)
  /// decision 181: the supplier's bills show VAT included | on-top | exempt (recorded, never computed)
  vatTreatment   String   @default("included")
  createdAt      DateTime @default(now())

  @@unique([tenantId, organizationId, name])
}

/// PURCHASE_ORDER machine states (@setu/domain machines.ts).
enum PurchaseOrderStatus {
  draft
  sent
  partially_received @map("partially-received")
  received
  cancelled
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  tenantId       String
  organizationId String
  supplierId     String
  /// PO/26/0001 once sent
  number         String?
  status         PurchaseOrderStatus @default(draft)
  /// what the order is expected to cost (Σ qty × unit cost), paisa
  totalPaisa     Int                 @default(0)
  rev            Int                 @default(1)
  /// above the threshold: the owner's / admin's approval Task
  approvalTaskId String?
  note           String?
  cancelReason   String?
  createdById    String
  createdAt      DateTime            @default(now())
  sentById       String?
  sentAt         DateTime?
  statusAt       DateTime            @default(now())
  lines          PurchaseOrderLine[]

  @@index([tenantId, organizationId, status])
}

model PurchaseOrderLine {
  id          String        @id @default(cuid())
  tenantId    String
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id])
  position    Int
  medicineKey String
  qty         Int
  /// expected unit cost per tablet / capsule, paisa
  costPaisa   Int
  receivedQty Int           @default(0)

  @@index([tenantId, orderId])
}

/// GOODS_RECEIPT machine states.
enum GoodsReceiptStatus {
  checking
  posted
  discarded
}

model GoodsReceipt {
  id                   String             @id @default(cuid())
  tenantId             String
  organizationId       String
  orderId              String
  supplierId           String
  /// GRN/26/0001 once posted
  number               String?
  supplierInvoiceNo    String?
  status               GoodsReceiptStatus @default(checking)
  rev                  Int                @default(1)
  invoicedPaisa        Int                @default(0)
  debitNotePaisa       Int                @default(0)
  /// decision 181 (external review A6): the supplier's VAT and AIT as on their bill — data only, not in what is owed
  supplierVatPaisa     Int                @default(0)
  supplierAitPaisa     Int                @default(0)
  /// the supplier's VAT treatment as it was when this receipt was posted
  supplierVatTreatment String?
  note                 String?
  createdById          String
  createdAt            DateTime           @default(now())
  postedById           String?
  postedAt             DateTime?
  statusAt             DateTime           @default(now())
  lines                GoodsReceiptLine[]

  @@index([tenantId, orderId])
}

model GoodsReceiptLine {
  id          String       @id @default(cuid())
  tenantId    String
  receiptId   String
  receipt     GoodsReceipt @relation(fields: [receiptId], references: [id])
  orderLineId String
  medicineKey String
  batchNo     String
  /// last usable day (yyyy-mm-dd)
  expiry      String
  /// what the supplier billed
  invoicedQty Int
  /// what arrived and was checked
  receivedQty Int
  costPaisa   Int
  mrpPaisa    Int
  vatRateBp   Int          @default(0)
  /// counter | store | fridge
  location    String       @default("store")
  /// the batch the received quantity went into (on posting)
  batchId     String?

  @@index([tenantId, receiptId])
}

/// What the facility owes a supplier (append-only): goods-received (+), debit-note (−), payment (−).
model SupplierEntry {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  supplierId     String
  kind           String
  amountPaisa    Int
  refType        String?
  refId          String?
  note           String?
  byId           String
  at             DateTime @default(now())

  @@index([tenantId, supplierId])
}

/// STOCK_COUNT machine states.
enum StockCountStatus {
  counting
  submitted
  approved
  rejected
  /// external review A6: still being entered when the counter's shift closed — ended with the reason, flagged
  abandoned
}

model StockCount {
  id             String           @id @default(cuid())
  tenantId       String
  organizationId String
  /// counter | store | fridge
  location       String
  status         StockCountStatus @default(counting)
  rev            Int              @default(1)
  createdById    String
  createdAt      DateTime         @default(now())
  submittedAt    DateTime?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  /// decision 234: decided by the person who counted, as the facility's only approver, with a note
  selfApproved   Boolean          @default(false)
  statusAt       DateTime         @default(now())
  lines          StockCountLine[]

  @@index([tenantId, organizationId, status])
}

model StockCountLine {
  id         String     @id @default(cuid())
  tenantId   String
  countId    String
  count      StockCount @relation(fields: [countId], references: [id])
  batchId    String
  /// the batch's quantity when the count started
  systemQty  Int
  /// external review B9: the batch\'s move number at the snapshot, and when this line was entered
  sinceSeq   Int?
  countedSeq Int?
  countedQty Int?
  reason     String?
  /// when this batch was counted — the adjustment allows for stock that moved between the start and this moment
  countedAt  DateTime?

  @@unique([countId, batchId])
}

/// A gateway's access token, shared by every API process (bKash allows two grants / refreshes an hour, ADR 0011). Not
/// a tenant table: one merchant account per deployment for the pilot. Reachable only through gateway_token_get / _put.
model GatewayToken {
  provider         String     @id
  idToken          String?
  idExpiresAt      DateTime?
  refreshToken     String?
  refreshExpiresAt DateTime?
  /// every grant / refresh call in the last hour, failed ones too (bKash blocks the app after two an hour)
  renewals         DateTime[] @default([])
  updatedAt        DateTime
}

/**
 * ───── refunds (ADR 0013) ─────
 */
/// REFUND machine states (@setu/domain machines.ts). withdrawn = approved, then not paid (never shown as rejected).
enum RefundStatus {
  requested
  approved
  paid
  rejected
  withdrawn
}

/// Money confirmed on one bill, given back. Lines are the credit note (bill lines with their VAT); allocations name the
/// confirmed payments it goes back against and how each is paid out. Approved through a Task (kind "refund-approval",
/// focus = the bill). Never deleted; paid is final.
model Refund {
  id                String             @id @default(cuid())
  tenantId          String
  organizationId    String
  invoiceId         String
  invoice           Invoice            @relation(fields: [invoiceId], references: [id])
  patientId         String?
  /// bill | reconciliation (money a gateway reported that never became confirmed money on the bill — no lines)
  source            String             @default("bill")
  /// refund (money goes back) | return (decision 221: medicine back on an unpaid bill, a credit — no money, no allocations)
  kind              String             @default("refund")
  /// decision 223: approved (or rejected) by the requester as the facility's only approver, with a note
  selfApproved      Boolean            @default(false)
  /// reconciliation: the case it came from
  caseTaskId        String?
  /// cancelled-test | wrong-dispense | overpayment | patient-request | other
  category          String
  reason            String
  status            RefundStatus       @default(requested)
  amountPaisa       Int
  netPaisa          Int
  vatPaisa          Int
  /// decision 233: the part of a return's value that lowers the due (credit = min(value, due)); the rest is refunded
  creditPaisa       Int                @default(0)
  /// a controlled drug on it, or card / bank money paid back in cash: the owner approves (not an admin)
  needsOwner        Boolean            @default(false)
  approvalTaskId    String?
  requestedById     String
  requestedAt       DateTime           @default(now())
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?
  withdrawnById     String?
  withdrawnAt       DateTime?
  withdrawNote      String?
  /// who took the money (often a relative), required when it is paid
  recipientName     String?
  recipientPhone    String?
  recipientRelation String?
  paidAt            DateTime?
  rev               Int                @default(1)
  statusAt          DateTime           @default(now())
  lines             RefundLine[]
  allocations       RefundAllocation[]
  voucher           RefundVoucher?

  @@index([tenantId, invoiceId])
  @@index([tenantId, organizationId, status])
}

/// One credit-note line: a part of a bill line (by amount, or by units for medicine), with its net and VAT. Written with
/// the request; never changed.
model RefundLine {
  id           String @id @default(cuid())
  tenantId     String
  refundId     String
  refund       Refund @relation(fields: [refundId], references: [id])
  chargeItemId String
  /// medicine lines: units returned
  units        Int?
  netPaisa     Int
  vatPaisa     Int
  totalPaisa   Int

  @@index([tenantId, refundId])
  @@index([tenantId, chargeItemId])
}

/// Which confirmed payment the money goes back against and how: cash (from the payer's open shift), gateway (the
/// wallet's refund API: claimed, then answered) or manual (by hand with a reference; flagged for the owner).
/// status open → paying (gateway claimed) → paid; a gateway refusal goes back to open with why.
model RefundAllocation {
  id                  String        @id @default(cuid())
  tenantId            String
  refundId            String
  refund              Refund        @relation(fields: [refundId], references: [id])
  paymentId           String
  method              PaymentMethod
  amountPaisa         Int
  /// cash | gateway | manual
  way                 String
  /// a wallet payment paid back in cash: no-wallet-access | gateway-failed
  cashReason          String?
  /// open | paying | paid
  status              String        @default("open")
  claimedById         String?
  claimedAt           DateTime?
  /// the gateway refused or failed this allocation's refund at least once (cash is then allowed)
  gatewayFailedAt     DateTime?
  failReason          String?
  refundTrxId         String?
  /// gateway: the transaction the money goes back against — the payment's own, or a reconciliation case's link
  /// (review: never the bill's current link by default)
  gatewayRef          String?
  gatewayTrxId        String?
  /// manual: the reference typed (bank / wallet / card slip)
  reference           String?
  /// cash: the shift the money left
  shiftId             String?
  paidById            String?
  paidAt              DateTime?
  /// manual (and card / bank → cash): the owner checks it against the statement (Task "refund-reconciliation")
  needsReconciliation Boolean       @default(false)
  reconcileTaskId     String?

  @@index([tenantId, refundId])
  @@index([tenantId, paymentId])
  @@index([tenantId, shiftId])
}

/// The refund voucher (RF/yy/nnnn per facility per year from Sequence, made when the refund is paid): an immutable copy
/// of what it prints, with a random verify code for the public check. Never updated or deleted.
model RefundVoucher {
  id             String               @id @default(cuid())
  tenantId       String
  organizationId String
  refundId       String               @unique
  refund         Refund               @relation(fields: [refundId], references: [id])
  invoiceId      String
  patientId      String?
  number         String
  verifyCode     String               @unique
  amountPaisa    Int
  snapshot       Json
  createdById    String
  createdAt      DateTime             @default(now())
  prints         RefundVoucherPrint[]

  @@unique([tenantId, organizationId, number])
  @@index([tenantId, invoiceId])
}

/// Every print of a refund voucher: copy 0 = the original, n ≥ 1 = "DUPLICATE #n" with a reason. Append-only.
model RefundVoucherPrint {
  id          String        @id @default(cuid())
  tenantId    String
  voucherId   String
  voucher     RefundVoucher @relation(fields: [voucherId], references: [id])
  copy        Int
  reason      String?
  format      String
  lang        String
  storageKey  String
  printedById String
  printedAt   DateTime      @default(now())

  @@unique([voucherId, copy])
  @@index([tenantId, voucherId])
}

/// A pharmacist's decision that returned units in quarantine are unopened and resaleable (a controlled drug: the
/// owner's): the transfer back to the counter (refId = transferRef) is backed by it. Append-only.
model StockResale {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  fromBatchId    String
  toBatchId      String
  qty            Int
  unopened       Boolean
  reason         String
  transferRef    String   @unique
  byId           String
  at             DateTime @default(now())

  @@index([tenantId, fromBatchId])
}

/**
 * ───── ADR 0015: the ward ─────
 */
enum MarDoseStatus {
  given
  held
  refused
  missed
  entered_in_error @map("entered-in-error")
}

/// One recorded dose against an active inpatient order (append-only; a wrong one is marked entered-in-error).
model MedicationAdministration {
  id                 String        @id @default(cuid())
  tenantId           String
  organizationId     String
  encounterId        String
  patientId          String
  requestId          String
  regimenId          String
  medicineKey        String
  /// the slot (a Dhaka time of day on a day); null for PRN
  scheduledFor       DateTime?
  status             MarDoseStatus
  administeredAt     DateTime
  recordedAt         DateTime      @default(now())
  administeredById   String
  preparedById       String
  checkPatient       Boolean       @default(false)
  checkDrug          Boolean       @default(false)
  checkDose          Boolean       @default(false)
  checkRoute         Boolean       @default(false)
  checkTime          Boolean       @default(false)
  /// on-time | early | late | prn
  timing             String
  reason             String?
  route              String
  doseText           String
  amountGiven        String?
  errorStockDrawn    String?
  /// ADR 0016 scan-to-verify: when the wristband matched, the ward batch whose label matched, or the override reason
  scanBandAt         DateTime?
  scanMedBatchId     String?
  scanOverrideReason String?
  doseQty            Int?
  /// ward-stock | patient-supplied
  source             String
  stockRef           String?
  highAlert          Boolean       @default(false)
  controlled         Boolean       @default(false)
  witnessedById      String?
  witnessedAt        DateTime?
  errorReason        String?
  errorById          String?
  errorAt            DateTime?

  @@index([tenantId, encounterId])
  @@index([tenantId, regimenId])
}

/// A multi-dose vial opened for a patient's order (consumed from ward stock when opened; opened-at shown on the MAR).
model MultiDoseVial {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  encounterId    String
  patientId      String
  requestId      String
  regimenId      String
  medicineKey    String
  source         String
  stockRef       String?
  openedAt       DateTime
  openedById     String
  recordedAt     DateTime @default(now())

  @@index([tenantId, encounterId])
}

enum EscalationStatus {
  raised
  doctor_informed @map("doctor-informed")
  resolved
}

/// NEWS2 escalation (ESCALATION): raised at or above the threshold or on a red score; one open per encounter.
model EscalationEvent {
  id               String           @id @default(cuid())
  tenantId         String
  organizationId   String
  encounterId      String
  patientId        String
  status           EscalationStatus
  score            Int
  peakScore        Int
  peakRed          Boolean          @default(false)
  ackDueAt         DateTime?
  acknowledgedAt   DateTime?
  acknowledgedById String?
  widenedAt        DateTime?
  red              Boolean
  observationId    String
  raisedAt         DateTime
  raisedById       String
  informedAt       DateTime?
  informedById     String?
  spokeTo          String?
  instruction      String?
  resolvedAt       DateTime?
  resolvedById     String?
  resolveNote      String?

  @@index([tenantId, encounterId])
}

enum NursingNoteStatus {
  active
  entered_in_error @map("entered-in-error")
}

/// Append-only nursing note, attributed to the signed-in nurse (no PIN: it works offline).
model NursingNote {
  id             String            @id @default(cuid())
  tenantId       String
  organizationId String
  encounterId    String
  patientId      String
  text           String
  writtenById    String
  writtenAt      DateTime          @default(now())
  /// device time (offline notes keep their real time)
  effectiveAt    DateTime
  status         NursingNoteStatus @default(active)
  errorReason    String?
  errorById      String?
  errorAt        DateTime?

  @@index([tenantId, encounterId])
}

enum IndentStatus {
  requested
  partially_issued @map("partially-issued")
  issued
  cancelled
}

model WardIndent {
  id             String           @id @default(cuid())
  tenantId       String
  organizationId String
  wardId         String
  number         String
  status         IndentStatus     @default(requested)
  note           String?
  requestedById  String
  requestedAt    DateTime         @default(now())
  statusAt       DateTime         @default(now())
  cancelledById  String?
  cancelReason   String?
  lines          WardIndentLine[]

  @@unique([tenantId, organizationId, number])
  @@index([tenantId, organizationId, status])
}

model WardIndentLine {
  id           String     @id @default(cuid())
  tenantId     String
  indentId     String
  indent       WardIndent @relation(fields: [indentId], references: [id])
  position     Int
  medicineKey  String
  qtyRequested Int
  qtyIssued    Int        @default(0)

  @@index([tenantId, indentId])
}

/// One issue of an indent line from one store batch to the ward (the two-leg transfer's reference).
model WardIndentIssue {
  id          String   @id @default(cuid())
  tenantId    String
  indentId    String
  lineId      String
  medicineKey String
  qty         Int
  fromBatchId String
  toBatchId   String
  byId        String
  at          DateTime @default(now())

  @@index([tenantId, indentId])
}

/// Controlled-drug register: one line per controlled issue to a ward, per dose given and per vial opened.
model ControlledDrugRegister {
  id               String   @id @default(cuid())
  tenantId         String
  organizationId   String
  medicineKey      String
  /// issue | administer | vial-open
  kind             String
  stockMoveId      String?  @unique
  batchId          String?
  qty              Int
  location         String
  balanceAfter     Int
  encounterId      String?
  patientId        String?
  administrationId String?
  indentId         String?
  byId             String
  witnessId        String?
  note             String?
  at               DateTime @default(now())

  @@index([tenantId, organizationId, medicineKey])
}

/// ADR 0016: intake / output, append-only (a wrong entry is marked entered-in-error by its writer).
model IntakeOutputEntry {
  id             String            @id @default(cuid())
  tenantId       String
  organizationId String
  encounterId    String
  patientId      String
  /// in | out
  side           String
  route          String
  ml             Int
  note           String?
  effectiveAt    DateTime
  writtenById    String
  writtenAt      DateTime          @default(now())
  status         NursingNoteStatus @default(active)
  errorReason    String?
  errorById      String?
  errorAt        DateTime?

  @@index([tenantId, encounterId, effectiveAt])
}

enum CareTaskStatus {
  requested
  completed
  cancelled
}

/// ADR 0016: a care plan task (once, or every N hours: completing one creates the next).
model CareTask {
  id             String         @id @default(cuid())
  tenantId       String
  organizationId String
  encounterId    String
  patientId      String
  seriesId       String
  previousId     String?
  text           String
  everyHours     Int?
  dueAt          DateTime
  status         CareTaskStatus @default(requested)
  createdById    String
  createdAt      DateTime       @default(now())
  completedById  String?
  completedAt    DateTime?
  cancelledById  String?
  cancelledAt    DateTime?
  cancelReason   String?

  @@index([tenantId, encounterId, status])
}

enum HandoverStatus {
  draft
  outgoing_signed @map("outgoing-signed")
  accepted
}

/// ADR 0016: one handover per ward per shift (draft → outgoing-signed → accepted; query back to draft).
model Handover {
  id             String            @id @default(cuid())
  tenantId       String
  organizationId String
  wardId         String
  shiftDay       String
  shiftStartHour Int
  status         HandoverStatus    @default(draft)
  rev            Int               @default(1)
  outgoingId     String
  signedAt       DateTime?
  incomingId     String?
  acceptedAt     DateTime?
  acceptNote     String?
  queryNote      String?
  queriedById    String?
  queriedAt      DateTime?
  createdAt      DateTime          @default(now())
  patients       HandoverPatient[]

  @@unique([organizationId, wardId, shiftDay, shiftStartHour])
  @@index([tenantId, wardId])
}

model HandoverPatient {
  id             String    @id @default(cuid())
  tenantId       String
  handoverId     String
  handover       Handover  @relation(fields: [handoverId], references: [id])
  encounterId    String
  patientId      String
  bed            String
  situation      String    @default("")
  background     String    @default("")
  assessment     String    @default("")
  recommendation String    @default("")
  /// latest NEWS2, open escalations, due doses, I/O balance, open tasks — refreshed while draft, frozen at signing
  snapshot       Json
  reviewed       Boolean   @default(false)
  reviewedAt     DateTime?

  @@unique([handoverId, encounterId])
}

/// ADR 0016: each wristband print (the first at admission; a reprint needs a reason). Append-only.
model WristbandPrint {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  admissionId    String
  encounterId    String
  patientId      String
  reason         String?
  printedById    String
  printedAt      DateTime @default(now())
  /// the 10-digit serial in the band's digit-only code (ADR 0016 amendment 2)
  serial         String?

  @@unique([tenantId, serial])
  @@index([tenantId, admissionId])
}

/// ADR 0016 amendment 2: the digit-only medicine label of a ward batch (92 + serial + mod-97 check). Append-only.
model BatchLabel {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  batchId        String
  serial         String
  createdById    String
  createdAt      DateTime @default(now())

  @@unique([tenantId, batchId])
  @@unique([tenantId, serial])
}

/// ADR 0017: a facility's bed-class daily rates (seeded from the sample classes, `sample` until the owner sets them).
model BedClassRate {
  id             String   @id @default(cuid())
  tenantId       String
  organizationId String
  bedClass       String
  nameEn         String
  nameBn         String
  perDayPaisa    Int
  sample         Boolean  @default(true)
  updatedAt      DateTime @default(now())

  @@unique([tenantId, organizationId, bedClass])
}

/// ADR 0017: an IPD package (catalogue). Admissions keep a snapshot, so changes never re-price an admitted patient.
model Package {
  id             String         @id @default(cuid())
  tenantId       String
  organizationId String
  code           String
  nameEn         String
  nameBn         String
  /// bed days included
  days           Int
  validFrom      String
  validTo        String?
  /// a sample pending sign-off (decision 5)
  sample         Boolean        @default(true)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())
  prices         PackagePrice[]
  items          PackageItem[]

  @@unique([tenantId, organizationId, code])
}

model PackagePrice {
  id         String  @id @default(cuid())
  tenantId   String
  packageId  String
  package    Package @relation(fields: [packageId], references: [id])
  bedClass   String
  pricePaisa Int

  @@unique([packageId, bedClass])
}

/// included: a service by charge code (limit null = any number) or a medicine by key; excluded: text shown on the bill
model PackageItem {
  id        String  @id @default(cuid())
  tenantId  String
  packageId String
  package   Package @relation(fields: [packageId], references: [id])
  /// service | medicine | excluded
  kind      String
  code      String?
  limitQty  Int?
  nameEn    String
  nameBn    String
  position  Int

  @@index([packageId])
}

/// ADR 0017: the discharge of an admission — ordered by the doctor, completed at the bed release or cancelled.
model Discharge {
  id             String          @id @default(cuid())
  tenantId       String
  organizationId String
  admissionId    String
  encounterId    String
  patientId      String
  /// ordered | completed | cancelled (DISCHARGE machine); completed when the patient left (or the body moved)
  status         String
  /// ADR 0018: normal | lama | death — each with its step graph
  kind           String          @default("normal")
  /// the LAMA record (reason, risks explained, form signed, witness) or the death record (time, cause, checks)
  detail         Json?
  advice         String
  targetAt       DateTime
  orderedById    String
  orderedAt      DateTime
  cancelledById  String?
  cancelledAt    DateTime?
  cancelReason   String?
  completedAt    DateTime?
  steps          DischargeStep[]

  @@index([tenantId, organizationId, status])
  @@index([tenantId, admissionId])
}

/// One of the six steps (DISCHARGE_STEP machine): waiting → in-progress → done.
model DischargeStep {
  id           String    @id @default(cuid())
  tenantId     String
  dischargeId  String
  discharge    Discharge @relation(fields: [dischargeId], references: [id])
  /// order | summary | pharmacy | final-bill | payment | bed-release
  key          String
  /// waiting | in-progress | done
  status       String
  startedAt    DateTime?
  /// "I'll take it": the person the header names when the step blocks
  takenById    String?
  takenAt      DateTime?
  doneById     String?
  doneAt       DateTime?
  /// done by hand with a PIN until slices B10 / B11 complete it from the real event (decision 8)
  byHand       Boolean   @default(false)
  note         String?
  detail       Json?
  remindedById String?
  remindedAt   DateTime?
  reminders    Int       @default(0)

  @@unique([dischargeId, key])
}

/// ADR 0017: each print of the interim bill (A4, "not a final bill", no QR): copy 0 the original, n ≥ 1 a duplicate with a reason. Append-only.
model InterimBillPrint {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String
  copy        Int
  reason      String?
  lang        String
  /// the running total printed
  totalPaisa  Int
  storageKey  String
  printedById String
  printedAt   DateTime @default(now())

  @@unique([invoiceId, copy])
}

/// Staging (week 2): a background job's last run (monitoring: job age). No tenant, no patient data.
model JobRun {
  name           String   @id
  lastStartedAt  DateTime
  lastFinishedAt DateTime
  lastOk         Boolean
  lastError      String?
  lastDetail     Json?
  runs           Int      @default(0)
  skips          Int      @default(0)
}
