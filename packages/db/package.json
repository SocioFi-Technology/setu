{
  "name": "@setu/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "migrate": "dotenv -e ../../.env -- tsx src/migrate.ts",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "test": "echo 'db: no unit tests (contract tests live in apps/api)'"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "@setu/domain": "workspace:*",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "dotenv-cli": "^8.0.0"
  }
}