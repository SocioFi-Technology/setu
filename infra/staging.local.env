# LOCAL REHEARSAL ONLY (infra/staging-smoke.sh): dev values, safe to commit — never used on a real host. The real
# staging env file lives in the host's secret store (ADR 0019) with NODE_ENV=production, real secrets and the
# provider sandboxes; this one runs the production images in development mode with the fake providers.
NODE_ENV=development
DATABASE_URL=postgresql://setu:setu@postgres:5432/setu
DATABASE_URL_APP=postgresql://setu_app:setu_app_local_rehearsal@postgres:5432/setu
REDIS_URL=redis://redis:6379
SESSION_SECRET=local-rehearsal-session-secret-0123456789abcdef
DEVICE_KEY_SECRET=local-rehearsal-device-key-secret-0123456789abc
GATEWAY_TOKEN_KEY=local-rehearsal-gateway-token-key-0123456789ab
WRISTBAND_SECRET=local-rehearsal-wristband-secret-0123456789abcd
PUBLIC_APP_URL=http://localhost:8088
VERIFY_BASE_URL=http://localhost:8088/verify/rc
STORAGE=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=setu-staging
S3_ACCESS_KEY=setu
S3_SECRET_KEY=setustagingsecret
S3_PATH_STYLE=1
PAYMENTS_PROVIDER=fake
FAKE_PAYMENTS_SECRET=local-rehearsal-fake-payments
SMS_PROVIDER=fake
AI_PROVIDER=off
