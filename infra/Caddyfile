# Staging / production edge (ADR 0019): TLS (automatic for a real domain), gzip, JSON access logs to stdout, and the
# staff app behind it — the staff app proxies /api/* to the API itself (so TRUST_PROXY=2: Caddy, then the rewrite).
{
	admin off
	log {
		output stdout
		format json
	}
}
{$SETU_SITE_ADDRESS::80} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	log {
		output stdout
		format json
	}
	reverse_proxy staff:3000 {
		health_uri /login
		health_interval 15s
	}
}
